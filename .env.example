# LOCAL: copiar para .env e gerar chave com: python -c "import secrets; print(secrets.token_urlsafe(64))"
AGENDAFLOW_ENV=development
AGENDAFLOW_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_KEY_OF_AT_LEAST_48_CHARACTERS
DATABASE_URL=sqlite:///./agendaflow_saas.sqlite3
PUBLIC_BASE_URL=http://localhost:8000
# Para produção: https://seu-dominio.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Para o docker-compose.prod.example.yml:
# Em produção, alterar as URLs e ALLOWED_HOSTS, e definir senha exclusiva de banco.
AGENDAFLOW_DOMAIN=agenda.exemplo.com
POSTGRES_PASSWORD=USE_UMA_SENHA_FORTE_NO_POSTGRESQL
# Stripe (teste ou produção; criar planos/preços na conta)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Email transacional (SMTP com STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AgendaFlow <no-reply@seudominio.com>
SUPPORT_EMAIL=suporte@seudominio.com
STRIPE_PRICE_STARTER=
